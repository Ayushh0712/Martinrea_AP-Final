# =============================================================================
#  ingestion env for the PRODUCTION compose stack (deploy/prod).
#  Sanitized template of deploy/prod/ingestion.env. Copy to that filename and
#  fill in the <PLACEHOLDER> secrets. Caddy routes /api/ingestion/* here (3002).
# =============================================================================

# INGESTION_PROFILE=local is intentional: it keeps the SFTP channel on the
# local (filesystem) adapter so the service does not crash at boot with no SFTP
# credentials. The blob + mail channels are switched to cloud transports
# explicitly below (BLOB_TRANSPORT=par, MAIL_TRANSPORT=imap), which override the
# profile default. See backend/ingestion/src/ingestion/ingestion.module.ts
INGESTION_PROFILE=local
MAIL_TRANSPORT=imap

PORT=3002
CORS_ORIGINS=http://<VM_PUBLIC_IP>

# ---- Portal-upload auth: in-stack Keycloak (matches workflow) --------------
# Ingestion uses the _URL-suffixed var names. KEYCLOAK_ROLE_CLAIM_PATH points at
# the realm roles (realm_access.roles), NOT the guard default resource_access.* —
# without this, uploads 401 with "No recognised AP role in token".
INGESTION_AUTH_MODE=keycloak
AUTH_PROVIDER=keycloak
JWT_SECRET=<UNUSED_IN_KEYCLOAK_MODE_BUT_KEEP_A_VALUE>
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/martinrea
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_ROLE_CLAIM_PATH=realm_access.roles

# ---- Storage: validated documents -> OCI Object Storage (PAR) --------------
# accepted -> BLOB_PAR_PREFIX (MUST match the workflow OCI_AUTOINGEST_PREFIX);
# rejected -> BLOB_PAR_QUARANTINE_PREFIX; dedup metadata -> BLOB_PAR_META_PREFIX.
BLOB_TRANSPORT=par
BLOB_PAR_BASE_URL=<OCI_PAR_URL_ENDING_IN_/o/>
BLOB_PAR_PREFIX=AP-Accepted_Correct/
BLOB_PAR_QUARANTINE_PREFIX=AP-Rejected_Correct/
BLOB_PAR_META_PREFIX=meta-correct/

# ---- SharePoint (Microsoft Graph) storage — unused while BLOB_TRANSPORT=par.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER=AP-Ingestion
SP_RAW_PREFIX=raw

# ---- Email source (MAIL_TRANSPORT=imap): Gmail App Password ----------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=<IMAP_USER>
IMAP_PASSWORD=<IMAP_APP_PASSWORD>
MAIL_AP_MAILBOXES=<IMAP_USER>

# Local working directories (inside the container).
LOCAL_STORAGE_DIR=.local-storage
LOCAL_MAILDIR=.local-maildir
LOCAL_SFTP_DIR=.local-sftp

# Polling (every 30 seconds for faster demo turnaround).
EMAIL_POLL_CRON=*/30 * * * * *
SFTP_POLL_CRON=*/30 * * * * *
