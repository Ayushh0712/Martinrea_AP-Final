# =============================================================================
#  workflow-service env for the PRODUCTION compose stack (deploy/prod).
#  Sanitized template of deploy/prod/workflow.env. Copy to that filename and
#  fill in the <PLACEHOLDER> secrets. Hostnames are the INTERNAL docker-compose
#  service names (postgres / redis / keycloak); only Caddy is public.
# =============================================================================

PORT=3001
# development => Sequelize synchronize() creates the schema on the fresh DB.
NODE_ENV=development

# Public entry point (Caddy on port 80). Used in approval-email deep links.
APP_BASE_URL=http://<VM_PUBLIC_IP>
CORS_ORIGINS=http://<VM_PUBLIC_IP>

# ---- OCR source: poll the OCI bucket for validated ingestion uploads --------
# Prefix MUST equal the ingestion service's BLOB_PAR_PREFIX (accepted docs).
OCI_AUTOINGEST_ENABLED=true
OCI_AUTOINGEST_CRON=*/30 * * * * *
OCI_AUTOINGEST_PREFIX=AP-Accepted_Correct/

# SharePoint OCR source disabled (OCI is the single source).
SP_AUTOINGEST_ENABLED=false
SP_AUTOINGEST_CRON=*/30 * * * * *
SP_AUTOINGEST_PREFIX=raw/
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER=AP-Ingestion

# ---- Database (compose `postgres` service) ---------------------------------
# DB_PASSWORD MUST match POSTGRES_PASSWORD in docker-compose.prod.yml.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<POSTGRES_PASSWORD_FROM_COMPOSE>
DB_NAME=mreai

# ---- Authentication: in-stack Keycloak (RS256) -----------------------------
# Issuer pinned to the INTERNAL keycloak URL (== KC_HOSTNAME_URL in compose),
# so the token `iss` matches what this service verifies against.
AUTH_PROVIDER=keycloak
JWT_SECRET=<UNUSED_IN_KEYCLOAK_MODE_BUT_KEEP_A_VALUE>
JWT_EXPIRES_IN=8h
KEYCLOAK_ISSUER=http://keycloak:8080/realms/martinrea
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_CLIENT_ID=martinrea-ap
KEYCLOAK_CLIENT_SECRET=<KEYCLOAK_CLIENT_SECRET_FROM_REALM_IMPORT>

# ---- Email notifications (WF-04) -------------------------------------------
# Set MAIL_ENABLED=false to disable. Gmail SMTP needs an App Password.
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_APP_PASSWORD>
SMTP_FROM="Martinrea AP <noreply@martinrea.local>"

SLA_PENDING_APPROVAL_HOURS=48
ESCALATION_CRON=0 * * * *

# ---- OCR pipeline (routes under /api/ocr/*) --------------------------------
# Redis / BullMQ = compose `redis` service.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
OCR_LANGUAGE=eng
OCR_MAX_RETRIES=3
CONFIDENCE_THRESHOLD=80
# Empty -> resolve `tesseract` from PATH (the workflow image installs it).
OCR_TESSERACT_PATH=
OCR_PSM=3
OCR_OEM=1
OCR_PREPROCESS=true
OCR_MAX_CONCURRENCY=2

# ---- PO drop folders (bind-mounted from the VM host) ------------------------
# Container paths matching the docker-compose.prod.yml volume mounts:
#   ../../PO-PDFs -> /data/po-pdfs   (dropped PDFs auto-uploaded to OCI)
#   ../../PO-Data -> /data/po-data   (dropped JSON ingested into the PO tables)
PO_PDF_LOCAL_DIR=/data/po-pdfs
PO_JSON_LOCAL_DIR=/data/po-data

# OCI Object Storage Pre-Authenticated Request URL (ends in /o/, read+write).
# PARs EXPIRE — refresh from the OCI console if OCR/ingest stops working.
OCI_PAR_URL=<OCI_PAR_URL_ENDING_IN_/o/>
