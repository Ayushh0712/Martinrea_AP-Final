# Martinrea AP ingestion — PRODUCTION (netlink-dev VM) env.
# Derived from backend/ingestion/.env. ONLY the network-dependent values differ
# (CORS -> VM public IP, Keycloak URLs -> internal container address). Mail /
# OCI / SFTP transports and all secrets are carried over unchanged.

INGESTION_PROFILE=local
MAIL_TRANSPORT=imap

PORT=3002

# Browser origins allowed to call the portal-upload endpoint (behind the proxy
# the browser only ever sees the VM origin).
CORS_ORIGINS=http://80.225.204.210

# Portal auth: local (dev bypass) | jwt (verify shared JWT_SECRET) | keycloak.
INGESTION_AUTH_MODE=keycloak
AUTH_PROVIDER=keycloak
JWT_SECRET=change-me-in-prod-this-is-only-for-local-development

# Keycloak verification — REUSE the existing host Keycloak (:8081). Ingestion
# only verifies (no login), so:
#   KEYCLOAK_ISSUER_URL = the token's `iss` (must match workflow's KEYCLOAK_ISSUER).
#   KEYCLOAK_JWKS_URL   = key fetch, container-reachable via host.docker.internal.
# NOTE: this guard enforces `aud` == KEYCLOAK_AUDIENCE, so the existing Keycloak's
# martinrea-ap client MUST have the audience mapper or uploads 401.
KEYCLOAK_ISSUER_URL=http://80.225.204.210:8081/realms/martinrea
KEYCLOAK_JWKS_URL=http://host.docker.internal:8081/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_ROLE_CLAIM_PATH=realm_access.roles

# ---- Storage: validated documents -> OCI Object Storage (PAR) --------------
# accepted -> BLOB_PAR_PREFIX; rejected -> BLOB_PAR_QUARANTINE_PREFIX. The
# workflow OCR poller fetches from BLOB_PAR_PREFIX, so it MUST match the
# workflow poller's OCI_AUTOINGEST_PREFIX ("AP-Accepted_Correct/").
BLOB_TRANSPORT=par
BLOB_PAR_BASE_URL=https://objectstorage.me-riyadh-1.oraclecloud.com/p/w5nk6CfntcPt3SWhfxwNk1i-Cwh0RZsRzl09EWnFUyX0OOo4Q_dYN-zRlK6u5Go7/n/bmuyboptp83n/b/netlink-poc-storage/o/
BLOB_PAR_PREFIX=AP-Accepted_Correct/
BLOB_PAR_QUARANTINE_PREFIX=AP-Rejected_Correct/
BLOB_PAR_META_PREFIX=meta-correct/

# ---- SharePoint (Microsoft Graph) storage — unused while BLOB_TRANSPORT=par.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER=AP-Ingestion
SP_RAW_PREFIX=raw

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=dummymreai@gmail.com
IMAP_PASSWORD=hubbmtorsmvlaxsv

MAIL_AP_MAILBOXES=dummymreai@gmail.com

# Local working directories (inside the container).
LOCAL_STORAGE_DIR=.local-storage
LOCAL_MAILDIR=.local-maildir
LOCAL_SFTP_DIR=.local-sftp

# Polling (every 30 seconds for faster demo turnaround)
EMAIL_POLL_CRON=*/30 * * * * *
SFTP_POLL_CRON=*/30 * * * * *
