# Martinrea AP workflow-service — PRODUCTION (netlink-dev VM) env.
# Derived from backend/workflow/.env. ONLY network-dependent values differ
# (hostnames -> Docker service names, localhost/LAN-IP -> the VM public IP,
# PO drop folders -> mounted container paths). All secrets + OCR tuning are
# carried over unchanged so behaviour matches local dev.

PORT=3001
# Kept as development on purpose: Sequelize synchronize() creates the schema on
# the fresh Postgres (see database.module.ts). Switch to production only once a
# migration tool owns the schema.
NODE_ENV=development

# Public entry point (Caddy on port 80). Used in approval-email deep links.
APP_BASE_URL=http://80.225.204.210

# Browser origins allowed to call the API. Behind the proxy the browser only
# ever sees the VM origin.
CORS_ORIGINS=http://80.225.204.210

# ---- OCR source: poll the OCI bucket for validated ingestion uploads --------
OCI_AUTOINGEST_ENABLED=true
OCI_AUTOINGEST_CRON=*/30 * * * * *
OCI_AUTOINGEST_PREFIX=AP-Accepted_Correct/

# SharePoint poller — disabled: Oracle (OCI) is the single OCR source.
SP_AUTOINGEST_ENABLED=false
SP_AUTOINGEST_CRON=*/30 * * * * *
SP_AUTOINGEST_PREFIX=raw/
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER=AP-Ingestion

# ---- Database: REUSE the existing host "appdb" Postgres (:8082) -------------
# The container reaches the host via host.docker.internal (extra_hosts in
# docker-compose.prod.yml). appdb must listen on 0.0.0.0:8082 and its
# pg_hba.conf must allow the Docker bridge subnet. VERIFY DB_PASSWORD on the VM.
DB_HOST=host.docker.internal
DB_PORT=8082
DB_USERNAME=martinrea
DB_PASSWORD=matrinrea_dev_pwd
DB_NAME=appdb

# Keycloak IdP — REUSE the existing host Keycloak (:8081). /api/auth/login does a
# server-side Direct Access Grant. Split addressing on purpose:
#   KEYCLOAK_ISSUER    = the token's `iss` (verification only, no network) — must
#                        equal what this Keycloak stamps; VERIFY by decoding a token.
#   KEYCLOAK_JWKS_URI  = key fetch, container-reachable via host.docker.internal.
#   KEYCLOAK_TOKEN_URL = login token endpoint, container-reachable (avoids the
#                        container-to-public-IP hairpin). Falls back to
#                        ${KEYCLOAK_ISSUER}/protocol/openid-connect/token if unset.
AUTH_PROVIDER=keycloak

JWT_SECRET=change-me-in-prod-this-is-only-for-local-development
JWT_EXPIRES_IN=8h

KEYCLOAK_ISSUER=http://80.225.204.210:8081/realms/martinrea
KEYCLOAK_JWKS_URI=http://host.docker.internal:8081/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://host.docker.internal:8081/realms/martinrea/protocol/openid-connect/token
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_CLIENT_ID=martinrea-ap
# VERIFY this matches the existing Keycloak's martinrea-ap client secret.
KEYCLOAK_CLIENT_SECRET=y8ycGTJrsMPNpe4l1v45v0E2G1vqaJMB

MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mramankhann@gmail.com
SMTP_PASSWORD=wchfbrtzafbxlnyt
SMTP_FROM="Martinrea AP <mramankhann@gmail.com>"

SLA_PENDING_APPROVAL_HOURS=48
ESCALATION_CRON=0 * * * *

# =============================================================================
#  OCR pipeline (merged AI-Invoice-OCR). Routes mounted under /api/ocr/*.
# =============================================================================
# Redis / BullMQ (OCR job queue) — Redis container on the internal network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# File uploads + OCR tuning
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
OCR_LANGUAGE=eng
OCR_MAX_RETRIES=3
CONFIDENCE_THRESHOLD=80
# Empty -> resolve `tesseract` from PATH (the workflow image installs it).
OCR_TESSERACT_PATH=
OCR_PSM=3
OCR_OEM=1
OCR_PREPROCESS=true
OCR_MAX_CONCURRENCY=2

# ---- PO drop folders (bind-mounted from the VM host) ------------------------
# Container paths matching the docker-compose.prod.yml volume mounts:
#   ../../PO-PDFs -> /data/po-pdfs   (dropped PDFs auto-uploaded to OCI)
#   ../../PO-Data -> /data/po-data   (dropped JSON ingested into the PO tables)
PO_PDF_LOCAL_DIR=/data/po-pdfs
PO_JSON_LOCAL_DIR=/data/po-data

# OCI Object Storage Pre-Authenticated Request URL (ends in /o/).
# NOTE: PARs expire — refresh from the OCI console if OCR/ingest stops working.
OCI_PAR_URL=https://objectstorage.me-riyadh-1.oraclecloud.com/p/w5nk6CfntcPt3SWhfxwNk1i-Cwh0RZsRzl09EWnFUyX0OOo4Q_dYN-zRlK6u5Go7/n/bmuyboptp83n/b/netlink-poc-storage/o/
