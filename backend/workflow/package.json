{
  "name": "martinrea-workflow-service",
  "version": "0.1.0",
  "description": "Martinrea AP Phase 1 - Workflow & Approvals service (WF-01..WF-05)",
  "private": true,
  "author": "Mohd Aman <workflow-track@netlink>",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "seed": "ts-node -r tsconfig-paths/register src/seeds/seed-users.ts",
    "seed:users": "ts-node -r tsconfig-paths/register src/seeds/seed-users.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register src/seeds/seed-roles.ts",
    "seed:rules": "ts-node -r tsconfig-paths/register src/seeds/seed-rules.ts",
    "seed:suppliers": "ts-node -r tsconfig-paths/register src/seeds/seed-suppliers.ts",
    "seed:vendors": "ts-node -r tsconfig-paths/register src/seeds/seed-vendors.ts",
    "seed:purchase-orders": "ts-node -r tsconfig-paths/register src/seeds/seed-purchase-orders.ts",
    "seed:purchase-order-lines": "ts-node -r tsconfig-paths/register src/seeds/seed-purchase-order-lines.ts",
    "seed:invoices": "ts-node -r tsconfig-paths/register src/seeds/seed-invoices.ts",
    "seed:invoice-line-items": "ts-node -r tsconfig-paths/register src/seeds/seed-invoice-line-items.ts",
    "seed:goods-receipts": "ts-node -r tsconfig-paths/register src/seeds/seed-goods-receipts.ts",
    "seed:goods-receipt-lines": "ts-node -r tsconfig-paths/register src/seeds/seed-goods-receipt-lines.ts",
    "seed:ocr-results": "ts-node -r tsconfig-paths/register src/seeds/seed-ocr-results.ts",
    "seed:match-records": "ts-node -r tsconfig-paths/register src/seeds/seed-match-records.ts",
    "seed:match-discrepancies": "ts-node -r tsconfig-paths/register src/seeds/seed-match-discrepancies.ts",
    "seed:invoice-po-line-reservations": "ts-node -r tsconfig-paths/register src/seeds/seed-invoice-po-line-reservations.ts",
    "seed:audit-logs": "ts-node -r tsconfig-paths/register src/seeds/seed-audit-logs.ts",
    "seed:remove-1012": "ts-node -r tsconfig-paths/register src/seeds/remove-invoice-1012.ts",
    "seed:reset": "ts-node -r tsconfig-paths/register src/seeds/reset-transactional-data.ts",
    "seed:recompute-drawdown": "ts-node -r tsconfig-paths/register src/seeds/recompute-po-drawdown.ts",
    "seed:pos-json": "ts-node -r tsconfig-paths/register src/seeds/seed-purchase-orders-from-json.ts",
    "seed:fresh": "npm run seed:reset && npm run seed:pos-json",
    "seed:all": "npm run seed:users && npm run seed:roles && npm run seed:rules && npm run seed:suppliers && npm run seed:purchase-orders && npm run seed:purchase-order-lines && npm run seed:invoices && npm run seed:invoice-line-items   && npm run seed:ocr-results && npm run seed:match-records && npm run seed:match-discrepancies && npm run seed:invoice-po-line-reservations && npm run seed:recompute-drawdown && npm run seed:audit-logs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "jwks-rsa": "^4.0.1",
    "multer": "^2.2.0",
    "nest-winston": "^1.9.7",
    "node-tesseract-ocr": "^2.2.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdf-poppler": "^0.2.1",
    "pdf2pic": "^3.1.3",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.33.5",
    "uuid": "^14.0.1",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.10",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
