# =============================================================================
#  Martinrea AP - Workflow Service - environment template
# =============================================================================
#  Legend:
#    [DEV-OK]     = value works as-is for local development
#    [CHANGE-ME]  = MUST be replaced before staging / production deployment
# =============================================================================

# ---- Server ----------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Used in approval email deep links (host of the AP UI - Dhwaj's Next.js app).
# [DEV-OK] points at localhost.
APP_BASE_URL=http://localhost:3000

# ---- PostgreSQL (matches docker-compose.yml defaults) ----------------------
# [DEV-OK] credentials below match the Docker container; in staging/prod the
# password and host come from Azure Key Vault.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=martinrea
DB_PASSWORD=martinrea_dev_pwd
DB_NAME=martinrea_ap

# ---- Authentication mode ---------------------------------------------------
# 'local'    -> /auth/login signs HS256 tokens with JWT_SECRET (default - fast
#               for development and unit tests).
# 'keycloak' -> /auth/login is disabled; clients obtain RS256 tokens from
#               Keycloak. The strategy validates them against JWKS.
# Roshni / Aditya / Vedant: flip this to 'keycloak' once the IdP decision is
# finalised. The Keycloak block below has dev defaults matching docker-compose.
AUTH_PROVIDER=local

# ---- JWT (WF-01, AUTH_PROVIDER=local only) ---------------------------------
JWT_SECRET=change-me-in-prod-this-is-only-for-local-development
JWT_EXPIRES_IN=8h

# ---- Keycloak (WF-01, AUTH_PROVIDER=keycloak only) -------------------------
# When AUTH_PROVIDER=keycloak the values below MUST match what's configured
# in the Keycloak admin UI. The JWKS_URI is derived from ISSUER; we keep it
# explicit so devs can see exactly what's being fetched.
# [CHANGE-ME] CLIENT_SECRET is per-environment - rotate before staging.
KEYCLOAK_ISSUER=http://localhost:8080/realms/martinrea
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_CLIENT_ID=martinrea-ap
KEYCLOAK_CLIENT_SECRET=

# ---- WF-04: Email / SMTP ---------------------------------------------------
# Point at your SMTP relay (dev setups use Gmail SMTP; see .env).
# Set MAIL_ENABLED=false to make NotificationsService a no-op (e.g. CI tests).
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Martinrea AP <noreply@martinrea.local>"

# [CHANGE-ME] For staging/prod, swap to Azure Communication Services or your
# corporate SMTP relay, e.g.:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=true
#   SMTP_USER=apnotifications@martinrea.com
#   SMTP_PASSWORD=<from Azure Key Vault>
#   SMTP_FROM="Martinrea AP <apnotifications@martinrea.com>"

# ---- WF-05: SLA escalation -------------------------------------------------
# PRD default: 48 hours. For test runs you can drop this to 0 or 1 to force
# escalation immediately (the included smoke script uses POST /api/escalation/run-now
# to trigger a cron tick on demand).
SLA_PENDING_APPROVAL_HOURS=48
# Standard cron expression. PRD WF-05 mandates "every hour".
ESCALATION_CRON=0 * * * *

# ---- OCR pipeline (merged AI-Invoice-OCR, routes under /api/ocr/*) ----------
# OCR persists via the shared Sequelize connection (DB_* above).

# Redis / BullMQ for the async OCR job queue (docker-compose ships one).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File uploads + OCR tuning.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
OCR_LANGUAGE=eng
OCR_MAX_RETRIES=3
CONFIDENCE_THRESHOLD=80
# C++ Tesseract CLI engine tuning.
# OCR_TESSERACT_PATH: absolute path to the tesseract binary. Leave empty to
#   resolve `tesseract` from PATH (Docker installs it there; on Windows point
#   this at e.g. C:\Program Files\Tesseract-OCR\tesseract.exe if not on PATH).
OCR_TESSERACT_PATH=
# --psm (page segmentation mode). 3 = fully automatic, no OSD.
OCR_PSM=3
# --oem (engine mode). 1 = LSTM only.
OCR_OEM=1
# Run sharp preprocessing (grayscale/normalize/upscale) before OCR.
OCR_PREPROCESS=true
# Max concurrent tesseract processes.
OCR_MAX_CONCURRENCY=2
# Directory holding the *.traineddata models. Leave empty to use Tesseract's
# compiled-in default; point at high-accuracy tessdata_best models in Docker
# (falls back to TESSDATA_PREFIX when unset).
OCR_TESSDATA_DIR=

# OCI Object Storage Pre-Authenticated Request URL (ends in /o/). Optional.
OCI_PAR_URL=

# ---- SharePoint / OneDrive (Microsoft Graph) OCR source ---------------------
# Alternative to OCI: pull validated documents the ingestion service wrote to a
# SharePoint document library / OneDrive drive (BLOB_TRANSPORT=sharepoint on the
# ingestion side). NOTE: a SharePoint *sharing link* (".../:u:/g/personal/...")
# will NOT work — Graph needs an app registration + the target drive id.
#   - App registration (Entra) with APPLICATION perm Files.Read.All /
#     Sites.Read.All + admin consent. Reuses GRAPH_* by default; set SP_GRAPH_*
#     only to override.
#   - SP_DRIVE_ID: the target drive id (resolve once via Graph; see the
#     ingestion .env.example for the exact GET calls).
#SP_GRAPH_TENANT_ID=
#SP_GRAPH_CLIENT_ID=
#SP_GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
# Must match the ingestion side (SP_ROOT_FOLDER + SP_RAW_PREFIX).
SP_ROOT_FOLDER=AP-Ingestion
# Auto-ingest poller for the SharePoint source (mirrors OCI_AUTOINGEST_*).
# Leave disabled to keep OCI as the OCR source; enable to switch to SharePoint.
SP_AUTOINGEST_ENABLED=false
SP_AUTOINGEST_CRON=*/30 * * * * *
SP_AUTOINGEST_PREFIX=raw/

# ---- Cross-service linking (ingestion -> OCR -> workflow) -------------------
# Auto-ingest: poll the shared OCI bucket for documents and OCR-extract any new
# ones into the in-memory review store (no DB write yet). NOTE: code default is
# OFF — must be enabled here (or in .env) to link the OCI -> OCR step.
OCI_AUTOINGEST_ENABLED=true
OCI_AUTOINGEST_CRON=*/30 * * * * *
# Source folder to OCR from (only AP-Accepted_Correct is processed for now).
OCI_AUTOINGEST_PREFIX=AP-Accepted_Correct/

# ---- Purchase-order ingest from OCI (2-way match data) -----------------------
# PO-JSON/: drop a .json file (a single PO object or an array — same shape as
# src/seeds/data/all_purchase_orders.json) and the poller upserts it straight
# into purchase_orders + purchase_order_lines. Idempotent; overwriting a file
# in the bucket re-ingests its new content. Code default is ON.
PO_JSON_INGEST_ENABLED=true
PO_JSON_INGEST_CRON=0 */2 * * * *
PO_JSON_PREFIX=PO-JSON/
# PO-PDFs/: PO source documents resolved by FILENAME convention — the PDF for
# PO-001 must be uploaded as PO-PDFs/PO-001.pdf (case-insensitive match).
PO_PDF_PREFIX=PO-PDFs/

# Local PDF drop folder: any .pdf placed here is auto-uploaded to the bucket's
# PO_PDF_PREFIX folder (name preserved — PO-001.pdf stays PO-001.pdf), then
# moved into its uploaded/ subfolder. Relative paths resolve against the
# service cwd (backend/workflow), so ../../PO-PDFs is the project-root folder.
# NOTE: uploads need OCI_PAR_URL created with "Permit object reads and writes".
PO_PDF_LOCAL_SYNC_ENABLED=true
PO_PDF_LOCAL_SYNC_CRON=*/30 * * * * *
PO_PDF_LOCAL_DIR=../../PO-PDFs

# Local JSON drop folder: any .json placed here is read DIRECTLY into the PO
# tables (no OCI involved). Files stay in the folder and are re-read only when
# their last-modified time changes — edit + save a file to re-ingest it.
PO_JSON_LOCAL_SYNC_ENABLED=true
PO_JSON_LOCAL_SYNC_CRON=*/30 * * * * *
PO_JSON_LOCAL_DIR=../../PO-Data

# Promote OCR-reviewed invoices into the workflow lifecycle (PRD section 5.2).
# NOTE: code default is OFF — must be enabled to link OCR -> workflow.
OCR_WORKFLOW_BRIDGE_ENABLED=true
OCR_WORKFLOW_BRIDGE_CRON=*/30 * * * * *
