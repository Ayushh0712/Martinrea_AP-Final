{
  "realm": "martinrea",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "AP_Clerk", "description": "Creates and edits invoices; cannot approve." },
      { "name": "Plant_Manager", "description": "First approver for invoices over $10,000." },
      { "name": "Finance_Director", "description": "Sole approver up to $10,000; second approver above." },
      { "name": "VP_Finance", "description": "Final approver for invoices over $50,000 (WF-03 Tier-3)." }
    ]
  },
  "clients": [
    {
      "clientId": "martinrea-ap",
      "name": "Martinrea AP Workflow Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "y8ycGTJrsMPNpe4l1v45v0E2G1vqaJMB",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "audience-martinrea-ap",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "martinrea-ap",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "plant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "plant_id",
            "claim.name": "plant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
