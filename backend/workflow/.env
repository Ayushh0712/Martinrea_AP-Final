# =============================================================================
#  OCR pipeline (merged AI-Invoice-OCR). Routes mounted under /api/ocr/*.
# =============================================================================
# Redis / BullMQ (OCR job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File uploads + OCR tuning
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
OCR_LANGUAGE=eng
OCR_MAX_RETRIES=3
CONFIDENCE_THRESHOLD=80
# C++ Tesseract CLI engine tuning.
# OCR_TESSERACT_PATH: absolute path to the tesseract binary. Leave empty to
#   resolve `tesseract` from PATH (Docker installs it there; on Windows point
#   this at e.g. C:\Program Files\Tesseract-OCR\tesseract.exe if not on PATH).
OCR_TESSERACT_PATH=
# --psm (page segmentation mode). 3 = fully automatic, no OSD.
OCR_PSM=3
# --oem (engine mode). 1 = LSTM only.
OCR_OEM=1
# Run sharp preprocessing (grayscale/normalize/upscale) before OCR.
OCR_PREPROCESS=true
# Max concurrent tesseract processes.
OCR_MAX_CONCURRENCY=2

# OCI Object Storage Pre-Authenticated Request URL (ends in /o/)
OCI_PAR_URL=https://objectstorage.me-riyadh-1.oraclecloud.com/p/w5nk6CfntcPt3SWhfxwNk1i-Cwh0RZsRzl09EWnFUyX0OOo4Q_dYN-zRlK6u5Go7/n/bmuyboptp83n/b/netlink-poc-storage/o/