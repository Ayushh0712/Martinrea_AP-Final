PORT=3001
NODE_ENV=development
APP_BASE_URL=http://10.221.149.102:3000

# Browser origins allowed to call the API (comma-separated). Drives CORS.
CORS_ORIGINS=http://localhost:3000,http://10.221.149.102:3000

# ---- OCR source: poll the OCI bucket for validated ingestion uploads --------
# OCI Object Storage is the single source. Ingestion (BLOB_TRANSPORT=par) writes
# accepted docs to BLOB_PAR_PREFIX (AP-Accepted_Correct/); this poller lists that
# prefix, downloads new files, and runs OCR. OCI_AUTOINGEST_PREFIX MUST match
# ingestion's BLOB_PAR_PREFIX ("AP-Accepted_Correct/").
OCI_AUTOINGEST_ENABLED=true
OCI_AUTOINGEST_CRON=*/30 * * * * *
OCI_AUTOINGEST_PREFIX=AP-Accepted_Correct/

# SharePoint poller — disabled: Oracle (OCI) is the single OCR source.
SP_AUTOINGEST_ENABLED=false
SP_AUTOINGEST_CRON=*/30 * * * * *
SP_AUTOINGEST_PREFIX=raw/
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER=AP-Ingestion

# OCR persistence is now unified onto the Sequelize schema (single Invoice
# table), so the former OCR->workflow bridge cron has been removed. These vars
# are obsolete and no longer read by any code.
# OCR_WORKFLOW_BRIDGE_ENABLED / OCR_WORKFLOW_BRIDGE_CRON: REMOVED

