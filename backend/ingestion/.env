# Demo-phase configuration (12 Jun 2026)
# Dummy Gmail inbox over IMAP; storage + SFTP stay on the local filesystem.
# Flip BLOB_TRANSPORT=http + BLOB_API_BASE_URL when Aman's backend endpoint is ready.

INGESTION_PROFILE=local
MAIL_TRANSPORT=imap

# Distinct port so ingestion (3002) coexists with workflow (3001),
# integrations (3003) and the frontend (3000).
PORT=3002

# Browser origins allowed to call the portal-upload endpoint.
CORS_ORIGINS=http://localhost:3000

# Portal auth: local (dev bypass) | jwt (verify shared JWT_SECRET) | keycloak.
INGESTION_AUTH_MODE=keycloak
AUTH_PROVIDER=keycloak
JWT_SECRET=change-me-in-prod-this-is-only-for-local-development

# Keycloak verification (KeycloakAuthGuard uses these *_URL names + role claim path).
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/martinrea
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_ROLE_CLAIM_PATH=realm_access.roles

# ---- Storage: validated documents -> OCI Object Storage (PAR) --------------
# Flow: portal/email/SFTP -> PreProcessing (validate) -> OCI bucket.
#   accepted -> BLOB_PAR_PREFIX            (AP-Accepted_Correct/<hash12>-<name> + meta-correct/.json)
#   rejected -> BLOB_PAR_QUARANTINE_PREFIX (AP-Rejected_Correct/<ts>-<reason>-<name> + .meta.json)
# The workflow OCR poller then fetches accepted docs from BLOB_PAR_PREFIX, so
# BLOB_PAR_PREFIX MUST match the workflow poller's OCI_AUTOINGEST_PREFIX.
BLOB_TRANSPORT=par
BLOB_PAR_BASE_URL=https://objectstorage.me-riyadh-1.oraclecloud.com/p/w5nk6CfntcPt3SWhfxwNk1i-Cwh0RZsRzl09EWnFUyX0OOo4Q_dYN-zRlK6u5Go7/n/bmuyboptp83n/b/netlink-poc-storage/o/
BLOB_PAR_PREFIX=AP-Accepted_Correct/
BLOB_PAR_QUARANTINE_PREFIX=AP-Rejected_Correct/
# Content-hash dedup namespace. Versioned to meta-correct/ so previously-ingested
# files can be re-ingested (OCI PARs cannot delete the old meta/ records).
BLOB_PAR_META_PREFIX=meta-correct/

# ---- SharePoint (Microsoft Graph) storage — unused while BLOB_TRANSPORT=par.
# To switch back: set BLOB_TRANSPORT=sharepoint and fill the four Graph creds
# (Entra app registration; a SharePoint *sharing link* will NOT work).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
SP_ROOT_FOLDER=AP-Ingestion
SP_RAW_PREFIX=raw

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=dummymreai@gmail.com
IMAP_PASSWORD=hubbmtorsmvlaxsv

MAIL_AP_MAILBOXES=dummymreai@gmail.com

# Local working directories
LOCAL_STORAGE_DIR=.local-storage
LOCAL_MAILDIR=.local-maildir
LOCAL_SFTP_DIR=.local-sftp

# Polling (every 30 seconds for faster demo turnaround)
EMAIL_POLL_CRON=*/30 * * * * *
SFTP_POLL_CRON=*/30 * * * * *
