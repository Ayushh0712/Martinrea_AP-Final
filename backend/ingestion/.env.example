# =============================================================================
# Martinrea AP Ingestion - PRODUCTION skeleton
# =============================================================================
# Copy this file to `.env` (or `.env.production`) on the deploy target.
# Real secrets MUST come from Azure Key Vault / your secret manager -- NEVER
# commit them. This file documents the shape only.
# =============================================================================

# -----------------------------------------------------------------------------
# Profile
# -----------------------------------------------------------------------------
# `local` (default): filesystem-backed adapters -- runs end-to-end with NO
#   external infra. Email/SFTP read from the LOCAL_* dirs below; accepted docs
#   land in LOCAL_STORAGE_DIR/raw, rejects in LOCAL_STORAGE_DIR/quarantine.
#   The auth guard accepts any `Bearer <token>` and injects a dev AP_Clerk
#   (override role with header `X-Dev-Role: Plant_Manager`).
# `prod`: real adapters (Graph/IMAP mail, ssh2-sftp-client, backend HTTP
#   blob API, Keycloak JWT verification). Each fails loudly at boot if its
#   creds/contract (see NEEDS.md) are missing.
INGESTION_PROFILE=local

# ---- Per-channel transport overrides (optional) -----------------------------
# Each channel can be overridden independently of the profile, so the demo
# can mix real and local transports. Unset = profile default
# (local profile -> all local; prod profile -> graph / http / ssh2).
#
#   MAIL_TRANSPORT = local | imap | graph
#   BLOB_TRANSPORT = local | http | par | sharepoint
#   SFTP_TRANSPORT = local | ssh2
#
# DEMO RECIPE (dummy Gmail inbox + everything else on this machine):
#   MAIL_TRANSPORT=imap
#   IMAP_USER=<dummy>@gmail.com
#   IMAP_PASSWORD=<gmail app password>
#   MAIL_AP_MAILBOXES=<dummy>@gmail.com
#MAIL_TRANSPORT=
#BLOB_TRANSPORT=
#SFTP_TRANSPORT=

# Local-transport working directories.
LOCAL_STORAGE_DIR=.local-storage
LOCAL_MAILDIR=.local-maildir
LOCAL_SFTP_DIR=.local-sftp

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Pre-processing rules
# -----------------------------------------------------------------------------
# Hard upper bound applied by both Multer (portal) and PreProcessingService
# (all channels). Anything bigger is rejected and quarantined.
MAX_FILE_BYTES=10485760

# Comma-separated MIME allowlist. file-type detects from magic bytes (NOT the
# client-provided header), so renaming `evil.exe -> evil.pdf` is caught here.
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff,application/xml,text/xml

# -----------------------------------------------------------------------------
# Auto-poll schedules (6-field cron, second granularity supported)
# -----------------------------------------------------------------------------
# Cron strings consumed by @nestjs/schedule's SchedulerRegistry. Override
# without redeploying by setting these env vars in your platform.
# Default: every 2 minutes (product decision, 12 Jun 2026).
EMAIL_POLL_CRON=0 */2 * * * *
SFTP_POLL_CRON=0 */2 * * * *

# -----------------------------------------------------------------------------
# Email channel
# -----------------------------------------------------------------------------
# Comma-separated list of AP mailboxes to poll. For the IMAP demo this is
# just the dummy Gmail address (used for attribution metadata).
MAIL_AP_MAILBOXES=ap-canada@martinrea.com,ap-mexico@martinrea.com

# ---- IMAP (MAIL_TRANSPORT=imap -- DEMO phase, dummy Gmail inbox) ------------
# For Gmail: enable 2FA on the dummy account, then create an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) and
# use it as IMAP_PASSWORD. Regular account passwords will NOT work.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# ---- Microsoft Graph (MAIL_TRANSPORT=graph -- future M365 production) -------
# App-only auth (client credentials grant). Needs Mail.Read.Shared
# (or Mail.Read on each mailbox) and Mail.ReadWrite (for folder moves).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SFTP channel -- ssh2-sftp-client (SftpClientFactory)
# -----------------------------------------------------------------------------
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
# PEM-encoded private key. In real prod this should be pulled from Key Vault
# at startup, NOT loaded from a plain env var.
SFTP_PRIVATE_KEY=

# Comma-separated remote paths to poll. One path per plant.
SFTP_INCOMING_PATHS=/incoming/welland,/incoming/saltillo

# Files modified within this window are skipped (partial-write guard --
# the partner / scanner may still be writing them).
SFTP_PARTIAL_WRITE_GRACE_MS=30000

# Bandwidth guard: files BIGGER than this are skipped at list-time without
# being downloaded. Files between MAX_FILE_BYTES and this ceiling ARE
# downloaded and quarantined (audit trail). Default = 50 MiB.
SFTP_HARD_CEILING_BYTES=52428800

# -----------------------------------------------------------------------------
# Blob storage -- backend document API (BLOB_TRANSPORT=http)
# -----------------------------------------------------------------------------
# The HTTP endpoint Mohd Aman connects this service to the backend with.
# Assumed contract: POST {base}/api/documents/upload -> { documentId,
# blobPath, isDuplicate }; POST {base}/api/documents/quarantine.
# If we later switch to direct Azure access, replace with
# AZURE_STORAGE_CONNECTION_STRING / AZURE_BLOB_CONTAINER and a new adapter.
BLOB_API_BASE_URL=
BLOB_API_AUTH_TOKEN=

# ---- OCI Object Storage via Pre-Authenticated Request (BLOB_TRANSPORT=par) --
# The PAR URL of the shared POC bucket, ending in /o/. PARs EXPIRE -- if
# uploads start failing with 401/404, regenerate the PAR in the OCI console.
# Layout written: raw/<hash12>-<name>, meta/<hash>.json, quarantine/<...>
BLOB_PAR_BASE_URL=

# ---- SharePoint / OneDrive via Microsoft Graph (BLOB_TRANSPORT=sharepoint) --
# Validated documents are written into a SharePoint document library (or
# OneDrive) drive folder, where the workflow OCR poller lists + fetches them.
# Same layout/dedup as the OCI adapter: <root>/raw/<hash12>-<name>,
# <root>/meta/<hash>.json, <root>/quarantine/<...>.
#
# IMPORTANT: a SharePoint *sharing link* (".../:u:/g/personal/.../<id>") will
# NOT work here -- it points at one file, not a writable container. You need:
#   1. An Entra (Azure AD) app registration with APPLICATION permission
#      Files.ReadWrite.All (OneDrive) or Sites.ReadWrite.All (SharePoint site),
#      with admin consent granted.
#   2. The target DRIVE id (SP_DRIVE_ID). Resolve it once via Graph, e.g.:
#        - Site library:  GET /sites/{hostname}:/sites/{path}:/drives  -> pick id
#        - User OneDrive: GET /users/{user}/drive                      -> id
# Credentials default to the GRAPH_* app above; set SP_GRAPH_* only to override.
#SP_GRAPH_TENANT_ID=
#SP_GRAPH_CLIENT_ID=
#SP_GRAPH_CLIENT_SECRET=
SP_DRIVE_ID=
# Base folder inside the drive that the whole AP pipeline lives under, and the
# accepted-docs subfolder. The workflow OCR poller MUST use the same values
# (SP_ROOT_FOLDER + SP_AUTOINGEST_PREFIX).
SP_ROOT_FOLDER=AP-Ingestion
SP_RAW_PREFIX=raw
SP_TIMEOUT_MS=15000
SP_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Auth -- Keycloak (KeycloakAuthGuard on the portal endpoint)
# -----------------------------------------------------------------------------
KEYCLOAK_ISSUER_URL=
KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=ap-ingestion-api
# Dot path into the JWT payload for the role claim, e.g.
# "resource_access.ap-ingestion-api.roles" for Keycloak client roles.
KEYCLOAK_ROLE_CLAIM_PATH=resource_access.ap-ingestion-api.roles
