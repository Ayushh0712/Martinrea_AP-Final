###############################################################################
# Martinrea Finance AP System — Phase 1
# UNIFIED ENVIRONMENT TEMPLATE (single source of truth for the linked stack)
#
# This file documents EVERY value the two backend services + the (future)
# frontend need. Copy the relevant blocks into each service's own `.env`
# (or feed them via docker-compose `env_file`). Values marked  <<< SERVER >>>
# are the ones you will fill in once the server / IdP credentials are issued.
#
# Services & ports (kept distinct so they + the frontend can run together):
#   frontend            http://localhost:3000   (added later)
#   workflow-service     :3001   (backend/workflow  — auth, invoices, OCR, audit)
#   ingestion            :3002   (INGESTION EPIC — email/SFTP/portal -> OCI)
###############################################################################


# =============================================================================
# 0. SHARED  (identical across every service — keep these in sync)
# =============================================================================
NODE_ENV=production

# ---- Single Postgres instance for the whole platform ----  <<< SERVER >>>
# workflow-service (Sequelize) points here; ingestion is stateless (OCI blob
# storage only).
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=martinrea_ap
DB_USER=martinrea
DB_PASSWORD=__SET_ON_SERVER__

# ---- Shared blob storage (OCI Object Storage Pre-Authenticated Request) ----
# This is the link already used by the ingestion folder. Ingestion WRITES here
# (raw/, meta/, quarantine/) and the backend READS/auto-ingests from the same
# bucket. Must end in /o/.  PARs expire — refresh from the OCI console.
OCI_PAR_URL=https://objectstorage.me-riyadh-1.oraclecloud.com/p/REPLACE_WITH_VALID_PAR/n/NAMESPACE/b/BUCKET/o/

# ---- Unified auth (one token works on both services) ----
# AUTH_PROVIDER=local    -> workflow-service issues HS256 JWTs at /api/auth/login;
#                           ingestion verifies with the SAME secret.
# AUTH_PROVIDER=keycloak -> all services verify RS256 tokens against Keycloak JWKS.
AUTH_PROVIDER=local
# Used in local mode by ALL THREE services — must be identical everywhere.
JWT_SECRET=__SET_A_LONG_RANDOM_SECRET__
JWT_EXPIRES_IN=8h

# ---- Keycloak (only needed when AUTH_PROVIDER=keycloak) ----  <<< SERVER >>>
KEYCLOAK_ISSUER=https://your-keycloak/realms/martinrea
KEYCLOAK_JWKS_URI=https://your-keycloak/realms/martinrea/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=martinrea-ap
KEYCLOAK_CLIENT_ID=martinrea-ap
KEYCLOAK_CLIENT_SECRET=__SET_ON_SERVER__

# ---- CORS: browser origins allowed to call the APIs (comma-separated) ----
CORS_ORIGINS=http://localhost:3000

# ---- Cross-service base URLs (how the services find each other) ----
WORKFLOW_BASE_URL=http://localhost:3001
INGESTION_BASE_URL=http://localhost:3002


# =============================================================================
# 1. workflow-service        (backend/workflow)
# =============================================================================
# PORT + DB_* + OCI_PAR_URL + AUTH_PROVIDER/JWT_*/KEYCLOAK_* + CORS_ORIGINS
# come from the SHARED block above. Service-specific values below.
PORT=3001
APP_BASE_URL=http://localhost:3000

# NOTE: workflow-service reads DB user/pass as DB_USERNAME / DB_PASSWORD.
DB_USERNAME=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# Prisma (OCR) connects to the SAME database, isolated in the `ocr` schema.
# Build from the shared DB_* values; URL-encode special chars in the password.
DATABASE_URL=postgresql://martinrea:__SET_ON_SERVER__@your-db-host:5432/martinrea_ap?schema=ocr

# Redis / BullMQ (OCR job queue)                                <<< SERVER >>>
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

# OCR tuning
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
OCR_LANGUAGE=eng+spa
OCR_MAX_RETRIES=3
CONFIDENCE_THRESHOLD=80

# Email notifications (WF-04)                                   <<< SERVER >>>
MAIL_ENABLED=true
SMTP_HOST=smtp.your-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=__SET_ON_SERVER__
SMTP_PASSWORD=__SET_ON_SERVER__
SMTP_FROM="Martinrea AP <noreply@martinrea.local>"

# SLA escalation (WF-05)
SLA_PENDING_APPROVAL_HOURS=48
ESCALATION_CRON=0 * * * *

# --- Linking toggles (added for cross-service integration) ---
# Auto-ingest: poll the shared OCI bucket for new ingestion uploads and run OCR.
OCI_AUTOINGEST_ENABLED=true
OCI_AUTOINGEST_CRON=0 */2 * * * *
OCI_AUTOINGEST_PREFIX=raw/
# Purchase-order ingest: PO-JSON/ holds .json PO data (auto-upserted into the
# PO tables); PO-PDFs/ holds PO documents fetched by filename (PO-001.pdf).
PO_JSON_INGEST_ENABLED=true
PO_JSON_INGEST_CRON=0 */2 * * * *
PO_JSON_PREFIX=PO-JSON/
PO_PDF_PREFIX=PO-PDFs/
# Local PDF drop folder (project-root PO-PDFs/): dropped PDFs are auto-uploaded
# to the bucket's PO_PDF_PREFIX folder, then archived to PO-PDFs/uploaded/.
# NOTE: requires OCI_PAR_URL created with "Permit object reads and writes".
PO_PDF_LOCAL_SYNC_ENABLED=true
PO_PDF_LOCAL_SYNC_CRON=*/30 * * * * *
PO_PDF_LOCAL_DIR=../../PO-PDFs
# Local JSON drop folder (project-root PO-Data/): dropped .json files are read
# DIRECTLY into the PO tables (no OCI). Files stay put; a file is re-read only
# when its last-modified time changes.
PO_JSON_LOCAL_SYNC_ENABLED=true
PO_JSON_LOCAL_SYNC_CRON=*/30 * * * * *
PO_JSON_LOCAL_DIR=../../PO-Data
# Promote OCR-reviewed invoices into the workflow lifecycle (PRD §5.2).
OCR_WORKFLOW_BRIDGE_ENABLED=true


# =============================================================================
# 2. ingestion                               (backend/ingestion)
# =============================================================================
PORT=3002
INGESTION_PROFILE=prod

# Blob: write straight to the shared OCI bucket (the link in this folder).
BLOB_TRANSPORT=par
BLOB_PAR_BASE_URL=${OCI_PAR_URL}

# Email source. demo = imap (Gmail). prod = graph (MS 365).     <<< SERVER >>>
MAIL_TRANSPORT=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=__SET_ON_SERVER__
IMAP_PASSWORD=__SET_ON_SERVER__
MAIL_AP_MAILBOXES=__SET_ON_SERVER__

# Microsoft Graph (only when MAIL_TRANSPORT=graph)              <<< SERVER >>>
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# SFTP (only when SFTP_TRANSPORT=ssh2)                          <<< SERVER >>>
SFTP_TRANSPORT=ssh2
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY=

# Polling cadence
EMAIL_POLL_CRON=0 */2 * * * *
SFTP_POLL_CRON=0 */2 * * * *

# Portal-upload auth. Ingestion verifies the SAME token as workflow-service.
# local  -> dev bypass (accepts any bearer, injects AP_Clerk)
# jwt    -> verify shared JWT_SECRET (recommended once linked)
# keycloak -> verify against Keycloak JWKS
INGESTION_AUTH_MODE=jwt
MAX_FILE_BYTES=10485760
