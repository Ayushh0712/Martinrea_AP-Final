# Frontend → backend API base URL.
# In local dev, point this straight at the Nest service.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Optional: OCI Object Storage pre-authenticated upload URL.
# Falls back to a dev default in src/lib/object-storage.ts when unset.
# NEXT_PUBLIC_OCI_PAR_URL=

# Where Next rewrites forward each /api path (used when NEXT_PUBLIC_API_BASE_URL=/api).
API_PROXY_TARGET=http://localhost:3001
INGESTION_PROXY_TARGET=http://localhost:3002
